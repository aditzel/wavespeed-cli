# Names-only template for local development. Keep real values in your shell or an
# ignored .env file and never commit them. README.md documents each variable.
# An empty value behaves the same as leaving the variable unset.

# Required for the built-in Wavespeed model and live model listing.
WAVESPEED_API_KEY=

# Optional MCP server settings.
# Directory MCP image-edit tools may read local images from (local reads are disabled when unset).
WAVESPEED_MCP_INPUT_DIR=
# Root for MCP `paths` output (defaults to the MCP server working directory when unset).
WAVESPEED_MCP_OUTPUT_DIR=

# Optional safety overrides. Set to 1 only for trusted setups.
# Allow non-Wavespeed API base URLs (required for any non-Wavespeed base in MCP mode).
WAVESPEED_ALLOW_CUSTOM_API_BASE_URL=
# Allow HTTP or localhost/private-network API base URLs for trusted local testing.
WAVESPEED_ALLOW_INSECURE_API_BASE_URL=
